# Python build, test and tool caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof
prof.out

# environments and editors
.venv/
venv/
.idea/
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db

# captures (customer data must never be committed)
*.jls

# analysis outputs
*_events/
*.html
*_analysis.json
*_summary.json
*.csv
sbom/
*.spdx

# Plotly is downloaded to a per-user cache, never stored here
plotly-*.js
